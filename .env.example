cat > .env.example << 'EOF'
# Servidor
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/kpop-groups-api?appName=Cluster0
MONGODB_URI_TEST=mongodb+srv://usuario:senha@cluster.mongodb.net/kpop-groups-test?appName=Cluster0

# Autenticação
JWT_SECRET=substitua-por-uma-chave-segreta
EOF